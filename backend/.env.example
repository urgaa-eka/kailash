# Kailash â€” Backend environment template.
# Copy to `.env` and fill in real values. Do NOT commit `.env`.

# ---------- Database ----------
MONGO_URL=mongodb://localhost:27017
DATABASE_NAME=kailash

# ---------- Security ----------
SECRET_KEY=change-me-to-a-long-random-string

# ---------- AI provider (choose ONE; OpenRouter takes precedence) ----------

# Option A â€” OpenRouter (OpenAI-compatible, lets you use many models)
# Docs: https://openrouter.ai/docs
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3-haiku
OPENROUTER_SITE_URL=https://kailash-ai.in
OPENROUTER_APP_NAME=Kailash

# Option B â€” Direct Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ---------- Vector / RAG (optional) ----------
PINECONE_API_KEY=
PINECONE_INDEX=kailashai
PINECONE_HOST=us-east-1

# ---------- Domain / CORS ----------
BACKEND_URL=https://api.kailash-ai.in
FRONTEND_URL=https://kailash-ai.in
# kailash-ai.com is where Firebase Hosting actually serves the SPA (the .in
# hosts 301 to it) -- without it here, every browser API call is CORS-blocked.
# See docs/records/production-domain.md.
ALLOWED_ORIGINS=https://kailash-ai.com,https://www.kailash-ai.com,https://kailash-ai.in,https://www.kailash-ai.in,https://kailash-29111.web.app,https://kailash-29111.firebaseapp.com

# ---------- Firebase Admin SDK ----------
# Option A â€” path to service account key JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=
# Option B â€” inline JSON string (CI/CD friendly, set in GitHub Secrets)
# FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=kailash-29111
FIREBASE_STORAGE_BUCKET=kailash-29111.firebasestorage.app
# Set FIREBASE_DISABLED=true to skip Firebase init
# FIREBASE_DISABLED=false

# ---------- Deployment ----------
# Frontend: Firebase Hosting (project: kailash-29111)
# Backend:  Vultr VPS (docker-compose + nginx reverse proxy)
# Docs:     See deploy/vultr/deploy.sh and frontend/firebase.json
