# Company segment — ledger service
SERVICE_NAME=company
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true

# PostgreSQL ledger (docker compose publishes the LOCAL container on loopback
# via docker-compose.override.yml)
COMPANY_DB_URL=postgresql://<user>:<password>@127.0.0.1:5432/kailash

# --- Managed Postgres (Supabase) ------------------------------------------
# To run the statutory ledger on Supabase instead of the local container, set
# COMPANY_DB_URL in the deployment .env to the Supabase connection string. The
# value is filled at deploy time; nothing is committed. docker-compose.yml
# reads ${COMPANY_DB_URL:-<local default>}, so this override wins when present.
#
#   COMPANY_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Notes:
#  - Session pooler (port 5432) is the safe default for the psycopg-based ledger.
#    If you use the TRANSACTION pooler (port 6543), prepared statements are
#    unsupported — the async backend (asyncpg) then needs statement_cache_size=0.
#  - Supabase requires TLS; append ?sslmode=require if your client does not
#    negotiate it automatically.
#  - The local `postgres` container still requires POSTGRES_PASSWORD unless you
#    drop `postgres` from the deploy service list (PROD_SERVICES in
#    deploy/host/deploy.sh and .github/workflows/deploy-backend.yml).

# Path to the company-segment scaffold; empty = auto-resolve <repo>/company-segment
COMPANY_SCAFFOLD_DIR=

# Internal service-to-service auth (empty = open in dev/test, fail-closed in prod)
PLATFORM_INTERNAL_TOKEN=

# Identities stamped on automated ingestion postings (maker-checker)
INGEST_MAKER=ingestion-api
INGEST_CHECKER=posting-engine
