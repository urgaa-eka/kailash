{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kailash/company-segment/ingestion/sales_invoice.contract.json",
  "title": "Sales Invoice Ingestion Contract",
  "description": "Canonical payload accepted by the Company-segment sales ingestion API. Validated, deduped by source_hash, then posted as Dr Debtor / Cr Sales / Cr Output GST.",
  "type": "object",
  "required": ["source_hash", "gstin", "invoice_no", "invoice_date", "party", "supply_type", "place_of_supply", "lines"],
  "additionalProperties": false,
  "properties": {
    "source_hash": { "type": "string", "description": "SHA-256 of canonical document; idempotency key (UNIQUE)" },
    "gstin": { "type": "string", "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[0-9A-Z]{1}Z[0-9A-Z]{1}$", "description": "Supplier GSTIN issuing the invoice" },
    "invoice_no": { "type": "string" },
    "invoice_date": { "type": "string", "format": "date" },
    "party": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "gstin": { "type": "string", "description": "Present => B2B; absent => B2C" },
        "pan": { "type": "string" },
        "state_code": { "type": "string", "pattern": "^[0-9]{2}$" }
      }
    },
    "supply_type": { "type": "string", "enum": ["B2B", "B2CL", "B2CS", "EXPORT", "SEZ", "NIL", "EXEMPT"] },
    "place_of_supply": { "type": "string", "pattern": "^[0-9]{2}$", "description": "State code; drives CGST+SGST vs IGST" },
    "reverse_charge": { "type": "boolean", "default": false },
    "irn": { "type": "string", "description": "e-invoice reference number (mandatory if turnover > 5cr, B2B/export)" },
    "ewb_no": { "type": "string", "description": "e-way bill number (goods movement > 50,000)" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["hsn_sac", "taxable_value", "gst_rate"],
        "properties": {
          "item_name": { "type": "string" },
          "hsn_sac": { "type": "string", "minLength": 4, "maxLength": 8 },
          "qty": { "type": "number" },
          "uqc": { "type": "string" },
          "rate": { "type": "number" },
          "taxable_value": { "type": "number", "minimum": 0 },
          "gst_rate": { "type": "number", "enum": [0, 0.25, 3, 5, 12, 18, 28, 40], "description": "GST 2.0 slab; resolved to co_tax_rate effective on invoice_date" }
        }
      }
    },
    "totals": {
      "type": "object",
      "description": "Optional; recomputed and asserted by the engine",
      "properties": {
        "taxable_value": { "type": "number" },
        "cgst": { "type": "number" },
        "sgst": { "type": "number" },
        "igst": { "type": "number" },
        "cess": { "type": "number" },
        "total_value": { "type": "number" }
      }
    }
  }
}
