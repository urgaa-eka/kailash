{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retained containers - the Cleanup_Record source of truth",
  "description": "Reviewed dispositions for containers on the Docker host that no tracked compose file owns. scripts/verify/orphan_review.py enforces exactly these constraints; docs/records/docker-host-cleanup.md is generated from the data file, never edited by hand. A retained entry must name a non-empty owner (Requirement 7.2) and record every published port with its bind address (Requirement 7.5). Entries never embed container environment values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["retained"],
  "properties": {
    "retained": {
      "type": "array",
      "items": { "$ref": "#/$defs/retained_entry" }
    },
    "proposed_removals": {
      "type": "array",
      "items": { "$ref": "#/$defs/removal_entry" }
    }
  },
  "$defs": {
    "retained_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image", "owner", "published_ports", "justification", "reviewed"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "published_ports": {
          "type": "array",
          "items": { "$ref": "#/$defs/published_port" }
        },
        "justification": { "type": "string", "minLength": 1 },
        "reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "published_port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_ip", "host_port", "container_port"],
      "properties": {
        "host_ip": { "type": "string", "minLength": 1 },
        "host_port": { "type": "string", "minLength": 1 },
        "container_port": { "type": "string", "minLength": 1 }
      }
    },
    "removal_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image", "reason", "reviewed"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
