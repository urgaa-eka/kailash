  SFC --> GST & TDS & ROC
  SCH -.-> SFC
  GST <--> GSTN
  GST & TDS & ROC --> VW
  AUR --> REC
  REC --> SM
  REC --> ER
  REC --> VW
  VW --> CACHE --> UI
  VW --> BI
  GST --> EXP
  ROC --> EXP
  TXT -.-> BR
  REC -.-> BR
  BR --> GRD
  VW --> EVB
  EVB --> AG
  EVB --> PRD
  COG -.-> APIG
  SEC -.-> GSTN
