# Kailash — staging compose credentials (spec task 12.4, Requirement 8.3)
#
# Copy to deploy/staging/.env.staging on the VPS (never commit the copy) and
# replace every placeholder:
#
#   umask 077
#   cp deploy/staging/.env.staging.example deploy/staging/.env.staging
#
# Every value below is a placeholder in the secret-scan grammar, on purpose:
# this file does not match the `*.env.example` exempt pattern, so anything
# that is not recognisably a placeholder is reported as a committed
# credential. Generate real values with `openssl rand -hex 32`.
#
# The names are STAGING_-prefixed so the staging credential set is disjoint
# from production's by name (Requirement 8.3). The same seven names exist as
# GitHub Actions secrets in the `staging` environment — names listed in
# docs/DEPLOYMENT.md §4 and docs/runbooks/staging.md; the values live only in
# GitHub and on the VPS.

STAGING_POSTGRES_PASSWORD=change-me-generate-a-long-random-string
STAGING_REDIS_PASSWORD=change-me-generate-a-long-random-string
STAGING_PLATFORM_INTERNAL_TOKEN=change-me-generate-a-long-random-string

# Pass-throughs, carrying no value of their own -- docker-compose.yml's ${VAR:?} sites
# interpolate at parse time even though deploy/staging/docker-compose.staging.yml
# re-pins every credential site to the STAGING_* names above. Compose >= v2.24
# interpolates ${...} inside env files, so these lines never need editing; on
# an older compose, write the value twice instead.
POSTGRES_PASSWORD=${STAGING_POSTGRES_PASSWORD}
REDIS_PASSWORD=${STAGING_REDIS_PASSWORD}
PLATFORM_INTERNAL_TOKEN=${STAGING_PLATFORM_INTERNAL_TOKEN}
